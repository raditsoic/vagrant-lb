# tiket lab DNS — serves {{ lab_domain }} locally on the host-only network,
# forwards everything else to VirtualBox NAT's built-in resolver.
# no-resolv is essential: lb's own /etc/resolv.conf points at 127.0.0.1
# (i.e. at dnsmasq itself), so dnsmasq must not read it for upstreams.
no-resolv
server=10.0.2.3
# 10.0.2.15 is the guest's NAT interface — VirtualBox's 5353 → 53 port
# forward (used for `dig @127.0.0.1 -p 5353 …` from WSL) delivers there.
listen-address=127.0.0.1,{{ hostvars['lb']['private_ip'] }},10.0.2.15
bind-interfaces
domain={{ lab_domain }}
{% for host in groups['all'] %}
host-record={{ host }}.{{ lab_domain }},{{ hostvars[host]['private_ip'] }}
{% endfor %}
