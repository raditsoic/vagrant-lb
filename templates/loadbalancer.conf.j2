# Backends are resolved via the lab's dnsmasq (see dnsmasq.conf.j2).
# nginx resolves upstream names once at start/reload — that's why the
# dnsmasq handler must run before the nginx handler.
upstream backend {
{% for host in groups['webservers'] %}
    server {{ host }}.{{ lab_domain }}:80;
{% endfor %}
}

server {
    listen 80;

    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
